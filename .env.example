# URL base del sistema externo de cuentas médicas
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com

# Timeout de conexión y lectura por petición HTTP (segundos, > 0)
HTTP_TIMEOUT_SECONDS=10.0

# Política de reintentos para fallos técnicos transitorios
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY_SECONDS=30.0

# Retardo opcional entre peticiones consecutivas al servicio externo (segundos, >= 0)
REQUEST_DELAY_SECONDS=0.0

# Rutas de entrada, salida, persistencia, log y bloqueo
INPUT_CSV_PATH=data/cuentas.csv
OUTPUT_EXCEL_PATH=output/consolidado_cuentas.xlsx
SQLITE_DB_PATH=state/rpa_cuentas.db
LOG_FILE_PATH=logs/rpa_cuentas.log
LOCK_FILE_PATH=state/rpa_cuentas.lock

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
